<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Multiserviços</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">MultiPortal</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#produtos">Produtos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#processo">Processo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contato">Contato</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <header class="print-hero">
        <div class="container h-100">
            <div class="row h-100 align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 text-white fw-bold">Impressão 3D em PLA</h1>
                    <p class="lead text-white">Transforme suas ideias em realidade com nossa tecnologia de impressão 3D de alta precisão</p>
                    <a href="#contato" class="btn btn-light btn-lg">Solicitar Orçamento</a>
                </div>
            </div>
        </div>
    </header>

    <section id="produtos" class="py-5">
        <div class="container">
            <h2 class="text-center mb-5">O que podemos criar para você</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="product-card">
                        <img src="/images/3d-print/prototipos.jpg" alt="Protótipos" class="img-fluid rounded mb-3">
                        <h3>Protótipos</h3>
                        <p>Desenvolva e teste seus produtos antes da produção em massa.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="product-card">
                        <img src="/images/3d-print/brindes.jpg" alt="Brindes Personalizados" class="img-fluid rounded mb-3">
                        <h3>Brindes Personalizados</h3>
                        <p>Brindes corporativos únicos com a sua marca.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="product-card">
                        <img src="/images/3d-print/miniaturas.jpg" alt="Miniaturas" class="img-fluid rounded mb-3">
                        <h3>Miniaturas</h3>
                        <p>Action figures e miniaturas colecionáveis personalizadas.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="material" class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-5">Por que PLA?</h2>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="feature-card text-center">
                        <i class="bi bi-tree text-success mb-3"></i>
                        <h4>Ecológico</h4>
                        <p>Material biodegradável derivado do milho</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="feature-card text-center">
                        <i class="bi bi-shield-check text-primary mb-3"></i>
                        <h4>Seguro</h4>
                        <p>Não tóxico e seguro para uso</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="feature-card text-center">
                        <i class="bi bi-palette text-warning mb-3"></i>
                        <h4>Versátil</h4>
                        <p>Disponível em várias cores</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="feature-card text-center">
                        <i class="bi bi-stars text-danger mb-3"></i>
                        <h4>Qualidade</h4>
                        <p>Acabamento brilhante e durável</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="processo" class="py-5">
        <div class="container">
            <h2 class="text-center mb-5">Como Funciona</h2>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="process-step text-center">
                        <div class="step-number">1</div>
                        <h4>Ideia</h4>
                        <p>Envie seu projeto ou ideia para análise</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="process-step text-center">
                        <div class="step-number">2</div>
                        <h4>Modelagem</h4>
                        <p>Criamos o modelo 3D do seu projeto</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="process-step text-center">
                        <div class="step-number">3</div>
                        <h4>Impressão</h4>
                        <p>Imprimimos com precisão em PLA</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="process-step text-center">
                        <div class="step-number">4</div>
                        <h4>Entrega</h4>
                        <p>Enviamos o produto finalizado</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contato" class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-5">Solicite um Orçamento</h2>
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <form class="contact-form">
                        <div class="mb-3">
                            <input type="text" name="from_name" class="form-control" placeholder="Nome" required>
                        </div>
                        <div class="mb-3">
                            <input type="email" name="reply_to" class="form-control" placeholder="Email" required>
                        </div>
                        <div class="mb-3">
                            <textarea name="message" class="form-control" rows="5" placeholder="Descreva seu projeto" required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg">Enviar Solicitação</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>MultiPortal - Impressão 3D</h5>
                    <p>Transformando ideias em realidade</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5>Contato</h5>
                    <p>Email: impressao3d@multiportal.com<br>
                    Tel: (11) 99999-9999</p>
                </div>
            </div>
        </div>
    </footer>

    <script type="module" src="/src/main.js"></script>
</body>
</html>
